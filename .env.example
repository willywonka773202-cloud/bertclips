# bertclips standalone service configuration

# Where the atomic JSON stores (config, campaigns, promos, clips, ledger) live.
BERTOS_RUNTIME_DIR=.bertos-runtime

# "local" enables the engine, the promo rail, and the factory bridge.
# Anything else runs the cockpit read-only (offline-graceful), like the cloud edge.
BERTOS_DEPLOYMENT_MODE=local

# The local BertClipsHub factory bridge (loopback). Leave default unless you moved it.
BERTCLIPS_DIR=

# Optional access gate for the POST (mutation) routes when exposed beyond loopback.
# Leave unset to run open on a private VPS behind your own firewall / reverse proxy.
BERTCLIPS_GATE_TOKEN=
